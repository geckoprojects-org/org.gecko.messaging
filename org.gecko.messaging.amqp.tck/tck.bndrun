# The TCK against the AMQP implementation; needs the broker of docker/brokers.sh (brokerUp).
# The instance under test is 'tck'; tck-cloudevents.bndrun tests the one with structured
# CloudEvents.
-library: enableOSGi-Test
-include: ${workspace}/cnf/ext/tck-run.bnd

-runrequires: \
	bnd.identity;id='org.gecko.messaging.tck',\
	bnd.identity;id='org.gecko.messaging.amqp',\
	bnd.identity;id='org.gecko.messaging.amqp.tck',\
	${tck.runrequires}

# AMQP topic exchange: segments separated by ., single-level wildcard *
-runproperties.amqp: \
	org.gecko.messaging.tck.separator=.,\
	org.gecko.messaging.tck.wildcard.single=*

# the TLS listener of the broker demands a client certificate (TlsTest)
-runproperties.tls: \
	org.gecko.messaging.tck.tls.uri=amqps://localhost:15677,\
	${tck.tls}
