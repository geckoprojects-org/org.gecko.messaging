# Shared setup of the TCK run projects (org.gecko.messaging.*.tck), included by their bndruns.
-runfw: org.apache.felix.framework;version='[7.0.5,8)'
-runee: JavaSE-21
-resolve.effective: active
-tester: biz.aQute.tester.junit-platform

tck.runrequires: \
	bnd.identity;id='org.apache.felix.scr',\
	bnd.identity;id='org.apache.felix.configadmin',\
	bnd.identity;id='org.apache.felix.configurator',\
	bnd.identity;id='org.apache.felix.cm.json',\
	bnd.identity;id='org.eclipse.parsson.jakarta.json',\
	bnd.identity;id='org.apache.aries.spifly.dynamic.framework.extension',\
	bnd.identity;id='junit-jupiter-engine',\
	bnd.identity;id='junit-platform-launcher'

-runproperties.tck: \
	org.gecko.messaging.tck.timeout=10000

# Mutual TLS (TlsTest): the stores docker/brokers.sh makes for the TLS listeners of its brokers. A
# run against such a broker adds
#   -runproperties.tls: org.gecko.messaging.tck.tls.uri=<uri>, ${tck.tls}
tck.tls: \
	org.gecko.messaging.tck.tls.keystore=${workspace}/build/tck-tls/client.p12,\
	org.gecko.messaging.tck.tls.truststore=${workspace}/build/tck-tls/truststore.p12,\
	org.gecko.messaging.tck.tls.password=tck-tls
