# Eclipse Fennec workspace fragment (Gradle) — additive bnd properties.
#
# Layered on top of the bndtools `workspace-minimal` base template (Local repository). Where a
# release goes — the DIM Nexus and Sonatype, the Release repository and `-releaserepo` — is
# cnf/ext/release.bnd.

# Single source of truth for the project coordinates: gradle.properties at the
# workspace root (also read natively by Gradle). bnd imports it so the same values
# drive both Gradle and bnd (see cnf/SETUP.MD).
-include: ${workspace}/gradle.properties

-library: \
	fennec,\
	fennecTest,\
	fennecJacoco

# 2.0.0: the messaging API is re-cut along the specification draft (RFC 0246); nothing
# of the 1.x API (org.gecko.osgi.messaging) survives binary compatible.
base-version: 2.0.0
javac.source: 21
javac.target: 21
-require-bnd: "(version>=7.4.0)"
-jpms-module-info:

# Maven Central (read-only) — not provided by workspace-minimal. The snapshot URL serves the
# Paho build of geckoprojects-org/paho (org.geckoprojects.paho, 1.3.0-SNAPSHOT).
# High plugin index so it never collides with the base plugins (.1/.2).
-plugin.5.Central: \
	aQute.bnd.repository.maven.provider.MavenBndRepository; \
		snapshotUrl="https://central.sonatype.com/repository/maven-snapshots/"; \
		releaseUrl=https://repo.maven.apache.org/maven2/; \
		index=${.}/central.mvn; \
		readOnly=true; \
		poll.time=-1; \
		name="Central"

# Project coordinates, imported from gradle.properties (single source).
github-orga:    ${github_org}
github-project: ${github_repository}
-groupid:       ${maven_group_id}

# Bundle and pom metadata of the Gecko project, over the fennec library's Eclipse defaults; the
# Sonatype Central Portal checks the pom's license, developers and scm.
Bundle-Vendor: Data In Motion
Bundle-License: EPL-2.0;description="Eclipse Public License 2.0";link="https://www.eclipse.org/legal/epl-2.0/"
Bundle-Developers: \
	jalbert; \
		email="j.albert@data-in-motion.biz"; \
		name="Juergen Albert"; \
		organization="Data In Motion"; \
		organizationUrl="https://www.datainmotion.de"; \
		roles="architect,developer", \
	mhoffmann; \
		name="Mark Hoffmann"; \
		email="m.hoffmann@data-in-motion.biz"; \
		organization="Data In Motion"; \
		organizationUrl="https://www.datainmotion.de"; \
		roles="developer,architect"
