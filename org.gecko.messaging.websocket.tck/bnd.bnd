Bundle-Name: Gecko Messaging WebSocket TCK Run
Bundle-Description: Runs the messaging TCK against the WebSocket implementation and the \
	WebSocket hub, both in the run (hub on port 18090). The instances connect through a TCP \
	proxy that serves as broker control. Holds the configurations and the proxy.

-buildpath: \
	osgi.annotation;version=latest,\
	org.gecko.messaging.tck;version=snapshot,\
	org.osgi.framework;version=latest,\
	org.osgi.service.component.annotations;version=latest

-includeresource: \
	OSGI-INF/configurator/=configs/
Require-Capability: osgi.extender;filter:='(osgi.extender=osgi.configurator)'

# the run projects hold launches only; they depend on every bundle they launch
-dependson: org.gecko.messaging.api, org.gecko.messaging.core, org.gecko.messaging.websocket, \
	org.gecko.messaging.websocket.hub, org.gecko.messaging.tck
