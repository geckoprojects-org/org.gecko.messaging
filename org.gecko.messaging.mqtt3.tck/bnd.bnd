Bundle-Name: Gecko Messaging MQTT 3.1.1 TCK Run
Bundle-Description: Runs the messaging TCK against the MQTT 3.1.1 implementation and a real broker \
	(Mosquitto from docker/brokers.sh, port 11883). The instances connect through a TCP proxy \
	that serves as broker control. Holds the instance configurations and the proxy.

-buildpath: \
	osgi.annotation;version=latest,\
	org.gecko.messaging.tck;version=snapshot,\
	org.osgi.framework;version=latest,\
	org.osgi.service.component.annotations;version=latest

-includeresource: \
	OSGI-INF/configurator/=configs/
Require-Capability: osgi.extender;filter:='(osgi.extender=osgi.configurator)'

# the run projects hold launches only; they depend on every bundle they launch
-dependson: org.gecko.messaging.api, org.gecko.messaging.core, org.gecko.messaging.mqtt3, org.gecko.messaging.tck

# a run project: launches and configurations, nothing to publish
-releaserepo:
