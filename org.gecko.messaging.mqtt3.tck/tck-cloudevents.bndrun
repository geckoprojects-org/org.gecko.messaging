# The TCK against the MQTT 3.1.1 implementation with structured CloudEvents; needs the broker of
# docker/brokers.sh (brokerUp).
-library: enableOSGi-Test
-include: ${workspace}/cnf/ext/tck-run.bnd

-runrequires: \
	bnd.identity;id='org.gecko.messaging.tck',\
	bnd.identity;id='org.gecko.messaging.mqtt3',\
	bnd.identity;id='org.gecko.messaging.mqtt3.tck',\
	${tck.runrequires}

-runproperties.instance: \
	org.gecko.messaging.tck.filter='(osgi.messaging.name=tck-cloudevents)'
