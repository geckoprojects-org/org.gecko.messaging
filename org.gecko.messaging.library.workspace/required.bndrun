# What a runtime of every messaging implementation needs; resolved, its -runbundles become the
# build path and so the repository index of the geckoMessaging workspace library.
-runfw: org.apache.felix.framework
-runee: JavaSE-21
-resolve.effective: active

-runrequires: \
	bnd.identity;id='org.gecko.messaging.api',\
	bnd.identity;id='org.gecko.messaging.core',\
	bnd.identity;id='org.gecko.messaging.memory',\
	bnd.identity;id='org.gecko.messaging.mqtt',\
	bnd.identity;id='org.gecko.messaging.mqtt3',\
	bnd.identity;id='org.gecko.messaging.amqp',\
	bnd.identity;id='org.gecko.messaging.websocket',\
	bnd.identity;id='org.gecko.messaging.websocket.hub',\
	bnd.identity;id='org.gecko.messaging.library.project',\
	bnd.identity;id='org.apache.felix.scr',\
	bnd.identity;id='org.apache.felix.configadmin'
-runbundles: \
	com.rabbitmq.client;version='[5.37.0,5.37.1)',\
	io.netty.buffer;version='[4.2.20,4.2.21)',\
	io.netty.codec-base;version='[4.2.20,4.2.21)',\
	io.netty.common;version='[4.2.20,4.2.21)',\
	io.netty.handler;version='[4.2.20,4.2.21)',\
	io.netty.resolver;version='[4.2.20,4.2.21)',\
	io.netty.transport;version='[4.2.20,4.2.21)',\
	io.netty.transport-native-unix-common;version='[4.2.20,4.2.21)',\
	org.apache.aries.spifly.dynamic.framework.extension;version='[1.3.7,1.3.8)',\
	org.apache.felix.configadmin;version='[1.9.26,1.9.27)',\
	org.apache.felix.scr;version='[2.2.12,2.2.13)',\
	org.eclipse.jetty.alpn.client;version='[12.1.14,12.1.15)',\
	org.eclipse.jetty.client;version='[12.1.14,12.1.15)',\
	org.eclipse.jetty.compression.common;version='[12.1.14,12.1.15)',\
	org.eclipse.jetty.http;version='[12.1.14,12.1.15)',\
	org.eclipse.jetty.io;version='[12.1.14,12.1.15)',\
	org.eclipse.jetty.server;version='[12.1.14,12.1.15)',\
	org.eclipse.jetty.util;version='[12.1.14,12.1.15)',\
	org.eclipse.jetty.websocket.api;version='[12.1.14,12.1.15)',\
	org.eclipse.jetty.websocket.client;version='[12.1.14,12.1.15)',\
	org.eclipse.jetty.websocket.common;version='[12.1.14,12.1.15)',\
	org.eclipse.jetty.websocket.core.client;version='[12.1.14,12.1.15)',\
	org.eclipse.jetty.websocket.core.common;version='[12.1.14,12.1.15)',\
	org.eclipse.jetty.websocket.core.server;version='[12.1.14,12.1.15)',\
	org.eclipse.jetty.websocket.server;version='[12.1.14,12.1.15)',\
	org.eclipse.paho.client.mqttv3;version='[1.3.0,1.3.1)',\
	org.eclipse.paho.mqttv5.client;version='[1.3.0,1.3.1)',\
	org.gecko.messaging.amqp;version=snapshot,\
	org.gecko.messaging.api;version=snapshot,\
	org.gecko.messaging.core;version=snapshot,\
	org.gecko.messaging.library.project;version=snapshot,\
	org.gecko.messaging.memory;version=snapshot,\
	org.gecko.messaging.mqtt;version=snapshot,\
	org.gecko.messaging.mqtt3;version=snapshot,\
	org.gecko.messaging.websocket;version=snapshot,\
	org.gecko.messaging.websocket.hub;version=snapshot,\
	org.osgi.service.component;version='[1.5.1,1.5.2)',\
	org.osgi.util.function;version='[1.2.0,1.2.1)',\
	org.osgi.util.promise;version='[1.3.0,1.3.1)',\
	org.osgi.util.pushstream;version='[1.1.0,1.1.1)',\
	slf4j.api;version='[2.0.17,2.0.18)',\
	slf4j.simple;version='[2.0.17,2.0.18)'